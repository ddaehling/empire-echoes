    "toll": {
      "type": "object",
      "description": "Human cost. Give ranges where historians give ranges; never round a death toll to make it tidy. Where a figure is printed, `source` or `note` must say where it comes from.",
      "additionalProperties": false,
      "properties": {
        "deathsLow": {
          "type": "integer",
          "minimum": 0
        },
        "deathsHigh": {
          "type": "integer",
          "minimum": 0
        },
        "displacedLow": {
          "type": "integer",
          "minimum": 0
        },
        "displacedHigh": {
          "type": "integer",
          "minimum": 0
        },
        "enslavedLow": {
          "type": "integer",
          "minimum": 0
        },
        "enslavedHigh": {
          "type": "integer",
          "minimum": 0
        },
        "money": {
          "type": "string",
          "description": "e.g. '£20 million compensation to slave-owners, 1834'."
        },
        "note": {
          "type": "string",
          "minLength": 8,
          "description": "Who is counted, by whom, and how disputed the figure is."
        },
        "source": {
          "type": "string",
          "minLength": 4,
          "maxLength": 300,
          "description": "THE CHECK LINE. Where these figures come from, named so a reader can go and look: a database, a commission, a register, a return, or a work cited in this record's own evidence[]. testimony.js enforces 'no check, no entry' on the 43 primary texts; the same rule applies to every quantity this atlas prints. Never assert a source that does not carry the figure."
        },
        "warrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/warrant"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/warrant"
              }
            }
          ],
          "description": "The record or records that warrant the figures in this object. One warrant, or a list where different figures rest on different records — the Barbados line rests on the Slave Compensation Commission registers for the award and on the voyage data for the number of people."
        }
      }
    },
